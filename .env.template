# Earnings Sentiment Analysis - Environment Configuration
# Copy this file to .env and add your API keys

# === REQUIRED FOR REAL DATA ===
# Polygon.io API Key (get from https://polygon.io)
# Recommended: Starter plan ($99/month) or higher
POLYGON_API_KEY=your_polygon_api_key_here

# === OPTIONAL DATA SOURCES ===
# Financial Modeling Prep (alternative/backup transcript source)
# Get from: https://financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage (earnings calendar data)
# Get free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# === TELEGRAM ALERTS (OPTIONAL) ===
# If you want to receive alerts via Telegram
# See: https://core.telegram.org/bots#creating-a-new-bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# === CONFIGURATION ===
# Use mock data (true/false)
# Set to true for testing without API keys
USE_MOCK_DATA=false

# Minimum transcripts required for analysis
MIN_TRANSCRIPTS=2

# Maximum age of cached sentiment data (days)
SENTIMENT_CACHE_DAYS=7

# === NOTES ===
# - POLYGON_API_KEY is the only key you really need
# - Set USE_MOCK_DATA=true to test without any API keys
# - Telegram settings are completely optional
# - FMP and Alpha Vantage are backup data sources
